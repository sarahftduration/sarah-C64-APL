; Numeric functions: an overlay (see overlay.inc). Spec: apl64.py, section "Numeric functions".
;
; The float program interpreter (mv_run) and the kernels of * and ⍟ that the scalar engine calls per element
; (k_fpow, k_flog, k_fexp, k_fln; entered with the left argument in fa and the right one in fb, giving the
; result in fa, carry set and A = the error on failure). The programs and constants come from the model
; (mathprog.inc, generated by tools/gen_math.py); the interpreter does what apl64.vm_run does, step for step,
; through the same float routines, so the two agree to the last bit.
;
; Accumulator: fa. Slots: mv_s (8 floats). Integer register: mv_ir. Program counter: mp. A program is
; pairs of bytes, an opcode and an operand; opcodes 32 to 47 and 48 to 63 run the next n = opcode & 15
; instructions only if fa is below / not below constant `operand`, and skip them otherwise.

mv_ir:   .word 0
mv_op:   .byte 0
mv_arg:  .byte 0
mv_j:    .word 0                ; (the dispatch pointer: must not straddle a page)
        .cerror (mv_j & $ff) == $ff, "mv_j would straddle a page"
mv_ta:   .fill 3                ; saved arguments and temporaries
mv_tb:   .fill 3
mv_t:    .fill 3
mv_n:    .byte 0                ; a small whole exponent
mv_neg:  .byte 0
mv_th:   .byte 0
mv_tl:   .byte 0
mv_s:    .fill 27               ; the slots

; A/X = the program (low, high). fa = the accumulator in, and out. Carry set: A = an error.
mv_run: sta mp
        stx mp+1
        lda #0
        sta mv_ir
        sta mv_ir+1
mr_l:   ldy #0
        lda (mp),y
        sta mv_op
        iny
        lda (mp),y
        sta mv_arg
        clc
        lda mp
        adc #2
        sta mp
        bcc mr_1
        inc mp+1
mr_1:   lda mv_op
        beq mr_done
        cmp #32
        bcs mr_if
        asl
        tax
        lda mv_tab,x
        sta mv_j
        lda mv_tab+1,x
        sta mv_j+1
        jsr mr_call
        bcc mr_l
        rts
mr_done: clc
        rts
mr_call: jmp (mv_j)

; a conditional: A = the opcode
mr_if:  lda mv_arg
        jsr mk_cmpk
        ldy #0                  ; y = 1 if fa is below the constant
        cmp #$ff
        bne mr_i3
        iny
mr_i3:  lda mv_op
        cmp #48
        bcs mr_ge
        cpy #1                  ; IFLT: run the next n only if below
        beq mr_run
        bne mr_skip
mr_ge:  cpy #1                  ; IFGE: only if not below
        beq mr_skip
mr_run: jmp mr_l
mr_skip:
        lda mv_op
        and #15
        asl
        clc
        adc mp
        sta mp
        bcc mr_run
        inc mp+1
        jmp mr_l

; A = a constant number: ca = fa, cb = the constant; A = keycmp's answer
mk_cmpk:
        sta mv_th
        asl
        clc
        adc mv_th
        tax
mk_cmpx:
        ldy #0
mk_c1:  lda fa,y
        sta ca,y
        lda mk_table,x
        sta cb,y
        inx
        iny
        cpy #3
        bne mk_c1
        jmp keycmp

; X = 3 * the operand
mv_x3:  lda mv_arg
        asl
        clc
        adc mv_arg
        tax
        rts

h_end:  clc
        rts
h_ldk:  jsr mv_x3
        lda mk_table,x
        sta fa
        lda mk_table+1,x
        sta fa+1
        lda mk_table+2,x
        sta fa+2
        clc
        rts
h_lds:  jsr mv_x3
        lda mv_s,x
        sta fa
        lda mv_s+1,x
        sta fa+1
        lda mv_s+2,x
        sta fa+2
        clc
        rts
h_sts:  jsr mv_x3
        lda fa
        sta mv_s,x
        lda fa+1
        sta mv_s+1,x
        lda fa+2
        sta mv_s+2,x
        clc
        rts

; fb = the slot / the constant
mv_fbs: jsr mv_x3
        lda mv_s,x
        sta fb
        lda mv_s+1,x
        sta fb+1
        lda mv_s+2,x
        sta fb+2
        rts
mv_fbk: jsr mv_x3
        lda mk_table,x
        sta fb
        lda mk_table+1,x
        sta fb+1
        lda mk_table+2,x
        sta fb+2
        rts
; fb = fa, fa = the slot / the constant (for the reversed operations)
mv_rs:  ldx #2
mv_rs1: lda fa,x
        sta fb,x
        dex
        bpl mv_rs1
        jsr mv_x3
        lda mv_s,x
        sta fa
        lda mv_s+1,x
        sta fa+1
        lda mv_s+2,x
        sta fa+2
        rts
mv_rk:  ldx #2
mv_rk1: lda fa,x
        sta fb,x
        dex
        bpl mv_rk1
        jsr mv_x3
        lda mk_table,x
        sta fa
        lda mk_table+1,x
        sta fa+1
        lda mk_table+2,x
        sta fa+2
        rts

mv_chk: bcc mv_ok
        lda #E_DOMAIN
        sec
mv_ok:  rts
mv_add: jsr f_add
        jmp mv_chk
mv_sub: jsr f_sub
        jmp mv_chk
mv_mul: jsr f_mul
        jmp mv_chk
mv_div: jsr f_div
        jmp mv_chk

h_adds: jsr mv_fbs
        jmp mv_add
h_subs: jsr mv_fbs
        jmp mv_sub
h_muls: jsr mv_fbs
        jmp mv_mul
h_divs: jsr mv_fbs
        jmp mv_div
h_rsubs: jsr mv_rs
        jmp mv_sub
h_rdivs: jsr mv_rs
        jmp mv_div
h_addk: jsr mv_fbk
        jmp mv_add
h_subk: jsr mv_fbk
        jmp mv_sub
h_mulk: jsr mv_fbk
        jmp mv_mul
h_divk: jsr mv_fbk
        jmp mv_div
h_rsubk: jsr mv_rk
        jmp mv_sub
h_rdivk: jsr mv_rk
        jmp mv_div

h_neg:  lda fa
        beq hn_r
        lda fa+1
        eor #$80
        sta fa+1
hn_r:   clc
        rts
h_abs:  lda fa+1
        and #$7f
        sta fa+1
        clc
        rts
h_frexp:
        lda fa                  ; ir = the exponent, fa = the significand with exponent 128
        sec
        sbc #128
        sta mv_ir
        lda #0
        bcs hf_1
        lda #$ff
hf_1:   sta mv_ir+1
        lda #128
        sta fa
        clc
        rts
h_itof: lda mv_ir
        sta ia
        lda mv_ir+1
        sta ia+1
        jsr i_to_f
        clc
        rts
h_round:                        ; ir = floor(fa + 0.5); fa stays
        ldx #2
hr_1:   lda fa,x
        sta mv_t,x
        dex
        bpl hr_1
        lda #MKC_HALF
        asl
        clc
        adc #MKC_HALF
        tax
        lda mk_table,x
        sta fb
        lda mk_table+1,x
        sta fb+1
        lda mk_table+2,x
        sta fb+2
        jsr f_add
        bcs hr_dom
        jsr flr_q
        cmp #1
        beq hr_dom
        lda ia+1
        bpl hr_ok
        cmp #$80                ; 32768 or more: only -32768 is int16
        bne hr_dom
        lda ia
        bne hr_dom
        lda sgn
        bpl hr_dom
hr_ok:  lda sgn
        bpl hr_2
        sec                     ; negative: ir = -magnitude
        lda #0
        sbc ia
        sta ia
        lda #0
        sbc ia+1
        sta ia+1
hr_2:   lda ia
        sta mv_ir
        lda ia+1
        sta mv_ir+1
        ldx #2
hr_3:   lda mv_t,x
        sta fa,x
        dex
        bpl hr_3
        clc
        rts
hr_dom: lda #E_DOMAIN
        sec
        rts
h_ldexp:                        ; fa = fa * 2^ir: overflow is DOMAIN ERROR, underflow is zero
        lda fa
        beq hl_ok
        clc
        adc mv_ir
        sta mv_tl
        lda mv_ir+1
        adc #0
        sta mv_th
        beq hl_lo
        bmi hl_zero
        lda #E_DOMAIN
        sec
        rts
hl_lo:  lda mv_tl
        beq hl_zero
        sta fa
hl_ok:  clc
        rts
hl_zero: lda #0
        sta fa
        sta fa+1
        sta fa+2
        clc
        rts
h_decir: lda mv_ir
        bne hd_1
        dec mv_ir+1
hd_1:   dec mv_ir
        clc
        rts
h_sarir: lda mv_ir+1
        cmp #$80
        ror
        sta mv_ir+1
        ror mv_ir
        clc
        rts
h_ifbit:                        ; operand: bit * 16 + n
        lda mv_arg
        lsr
        lsr
        lsr
        lsr
        tax
        lda mv_ir
        cpx #0
        beq hb_1
hb_l:   lsr
        dex
        bne hb_l
hb_1:   and #1
        bne hb_run
        lda mv_arg              ; not set: skip n instructions
        and #15
        asl
        clc
        adc mp
        sta mp
        bcc hb_run
        inc mp+1
hb_run: clc
        rts
h_negs: jsr mv_x3
        lda mv_s,x
        beq hg_r
        lda mv_s+1,x
        bpl hg_r
        lda fa
        beq hg_r
        lda fa+1
        eor #$80
        sta fa+1
hg_r:   clc
        rts
h_setir: lda mv_arg
        sta mv_ir
        lda #0
        sta mv_ir+1
        clc
        rts

; --- the kernels ------------------------------------------------------------------------------------------
mk_fbfa: ldx #2
mf_1:   lda fb,x
        sta fa,x
        dex
        bpl mf_1
        rts
mk_save_a: ldx #2
ms_1:   lda fa,x
        sta mv_ta,x
        dex
        bpl ms_1
        rts
mk_restore_a: ldx #2
mr_a1:  lda mv_ta,x
        sta fa,x
        dex
        bpl mr_a1
        rts
mk_zero: lda #0
        sta fa
        sta fa+1
        sta fa+2
        clc
        rts
mk_dom: lda #E_DOMAIN
        sec
        rts
mk_nonce:
k_fnonce:
        lda #E_NONCE
        sec
        rts

; e to the power fb
k_fexp: jsr mk_fbfa
mk_exp: lda #MKC_M100           ; below -100 it is zero
        jsr mk_cmpk
        cmp #$ff
        bne me_1
        jmp mk_zero
me_1:   lda #MKC_P89            ; above 89 it overflows
        jsr mk_cmpk
        cmp #1
        bne me_2
        jmp mk_dom
me_2:   lda #<mp_exp
        ldx #>mp_exp
        jmp mv_run

; the natural logarithm of fb
k_fln:  jsr mk_fbfa
mk_ln:  lda fa                  ; zero and negative numbers are DOMAIN ERROR
        beq mk_dom
        lda fa+1
        bmi mk_dom
        lda #<mp_ln
        ldx #>mp_ln
        jmp mv_run

; the logarithm of fb to the base fa
k_flog: jsr mk_save_a
        jsr mk_fbfa
        jsr mk_ln
        bcs kl_r
        ldx #2
kl_1:   lda fa,x
        sta mv_tb,x
        dex
        bpl kl_1
        jsr mk_restore_a
        jsr mk_ln
        bcs kl_r
        ldx #2
kl_2:   lda fa,x
        sta fb,x
        lda mv_tb,x
        sta fa,x
        dex
        bpl kl_2
        jsr f_div
        jmp mv_chk
kl_r:   rts

; fa = fa to the whole power mv_n (1 to 127), by repeated squaring
mk_powi:
        jsr mk_save_a
        lda #MKC_ONE
        asl
        clc
        adc #MKC_ONE
        tax
        ldy #0
mp_1:   lda mk_table,x
        sta mv_t,y
        inx
        iny
        cpy #3
        bne mp_1
mp_l:   lsr mv_n
        bcc mp_s
        ldx #2
mp_2:   lda mv_t,x
        sta fa,x
        lda mv_ta,x
        sta fb,x
        dex
        bpl mp_2
        jsr f_mul
        bcs mp_dom
        ldx #2
mp_3:   lda fa,x
        sta mv_t,x
        dex
        bpl mp_3
mp_s:   lda mv_n
        beq mp_done
        ldx #2
mp_4:   lda mv_ta,x
        sta fa,x
        sta fb,x
        dex
        bpl mp_4
        jsr f_mul
        bcs mp_dom
        ldx #2
mp_5:   lda fa,x
        sta mv_ta,x
        dex
        bpl mp_5
        jmp mp_l
mp_done: ldx #2
mp_6:   lda mv_t,x
        sta fa,x
        dex
        bpl mp_6
        clc
        rts
mp_dom: lda #E_DOMAIN
        sec
        rts

; the power: fa to the fb
k_fpow: jsr mk_save_a
        ldx #2
kp_1:   lda fb,x
        sta mv_tb,x
        dex
        bpl kp_1
        lda fb                  ; b = 0: 1
        bne kp_2
        lda #MKC_ONE
        asl
        clc
        adc #MKC_ONE
        tax
        ldy #0
kp_o:   lda mk_table,x
        sta fa,y
        inx
        iny
        cpy #3
        bne kp_o
        clc
        rts
kp_2:   lda fa                  ; a = 0: 0, or DOMAIN ERROR for a negative b
        bne kp_3
        lda fb+1
        bmi kp_d
        clc
        rts
kp_d:   jmp mk_dom
kp_3:   jsr mk_fbfa             ; is b a whole number?
        jsr flr_q
        cmp #1
        beq kp_gen              ; (2^16 or more: whole, but too big for a product)
        lda ia
        sta mv_n
        lda ia+1
        sta mv_th
        lda sgn
        sta mv_neg
        jsr m_to_f
        ldx #2
kp_4:   lda fa,x
        cmp mv_tb,x
        bne kp_gen              ; not whole
        dex
        bpl kp_4
        lda mv_th
        bne kp_gen
        lda mv_n
        bmi kp_gen              ; above 127
        beq kp_gen
        jsr mk_restore_a        ; a whole power of magnitude 1 to 127
        jsr mk_powi
        bcs kp_r
        lda mv_neg
        bpl kp_r
        ldx #2                  ; a negative power: 1 / the product
kp_5:   lda fa,x
        sta fb,x
        dex
        bpl kp_5
        lda #MKC_ONE
        asl
        clc
        adc #MKC_ONE
        tax
        ldy #0
kp_6:   lda mk_table,x
        sta fa,y
        inx
        iny
        cpy #3
        bne kp_6
        jsr f_div
        jmp mv_chk
kp_r:   rts
kp_gen: lda mv_ta+1             ; a negative a needs a whole power: DOMAIN ERROR
        bmi kp_d
        ldx #0                  ; b = 0.5: the square root
        lda #MKC_HALF
        asl
        clc
        adc #MKC_HALF
        tay
kp_7:   lda mk_table,y
        cmp mv_tb,x
        bne kp_8
        iny
        inx
        cpx #3
        bne kp_7
        jsr mk_restore_a
        lda #<mp_sqrt
        ldx #>mp_sqrt
        jmp mv_run
kp_8:   jsr mk_restore_a        ; exp(b ln a)
        jsr mk_ln
        bcs kp_r
        ldx #2
kp_9:   lda mv_tb,x
        sta fb,x
        dex
        bpl kp_9
        jsr f_mul
        bcc kp_e
        jmp kp_d
kp_e:   jmp mk_exp

        .include "mathprog.inc"
